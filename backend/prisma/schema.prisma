generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum UserRole {
  OWNER
  EMPLOYEE
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}
model Organization {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  currency     String @default("KZT")
  address      String @default("")
  businessId   String @default("")
  auditEvents  AuditEvent[]
  invitations  Invitation[]
  tasks        BusinessTask[]
  orderSeq     Int @default(0)
  documentSeq  Int @default(0)
  bankName String @default("")
  iban String @default("")
  bic String @default("")
  version Int @default(1)
  users        User[]
  clients      Client[]
  orders       Order[]
  payments     Payment[]
  expenses     Expense[]
  documents    Document[]
}
model User {
  id             String @id @default(uuid()) @db.Uuid
  email          String @unique
  name           String
  passwordHash   String
  role           UserRole @default(EMPLOYEE)
  isActive       Boolean @default(true)
  version        Int @default(1)
  assignedTasks  BusinessTask[]
  taskComments   TaskComment[]
  notifications  Notification[]
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  sessions       Session[]
  @@unique([id, organizationId])
}
model Session {
  id String @unique @default(uuid()) @db.Uuid
  createdAt DateTime? @default(now())
  userAgent String @default("") @db.VarChar(300)
  tokenHash String @id
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
  @@index([userId, expiresAt])
}
model Client {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  phone          String @default("")
  email          String @default("")
  company        String @default("")
  address        String @default("")
  createdAt      DateTime @default(now())
  businessId String @default("")
  bankName String @default("")
  iban String @default("")
  bic String @default("")
  version Int @default(1)
  orders         Order[]
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
}
model Order {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String @db.Uuid
  client         Client @relation(fields: [clientId, organizationId], references: [id, organizationId])
  number         Int
  title          String
  status         OrderStatus @default(NEW)
  version        Int @default(1)
  total          Decimal @db.Decimal(18,2)
  dueDate        DateTime? @db.Date
  notes          String @default("")
  createdAt      DateTime @default(now())
  items          OrderItem[]
  payments       Payment[]
  expenses       Expense[]
  documents      Document[]
  tasks          BusinessTask[]
  @@unique([organizationId, number])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt, id])
}
model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @db.Uuid
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(18,2)
  total       Decimal @db.Decimal(18,2)
}
model Payment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderId        String @db.Uuid
  order          Order @relation(fields: [orderId, organizationId], references: [id, organizationId])
  amount         Decimal @db.Decimal(18,2)
  note           String @default("")
  idempotencyKey String @db.Uuid
  createdAt      DateTime @default(now())
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
}
model Expense {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderId        String? @db.Uuid
  order          Order? @relation(fields: [orderId, organizationId], references: [id, organizationId])
  amount         Decimal @db.Decimal(18,2)
  description    String
  category       String
  idempotencyKey String @db.Uuid
  createdAt      DateTime @default(now())
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
}
model Document {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderId        String @db.Uuid
  order          Order @relation(fields: [orderId, organizationId], references: [id, organizationId])
  number         Int
  kind           String @default("ACT_DRAFT")
  idempotencyKey String? @db.Uuid
  status         String @default("DRAFT")
  version        Int @default(1)
  annulledAt     DateTime?
  annulledById   String? @db.Uuid
  annulledByName String?
  annulmentReason String?
  annulmentKey   String? @db.Uuid
  snapshot       Json
  createdAt      DateTime @default(now())
  @@unique([organizationId, number])
  @@unique([organizationId, annulmentKey])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
}

model AuditEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String @db.Uuid
  actorName      String
  entityType     String
  entityId       String @db.Uuid
  action         String
  metadata       Json
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt, id])
  @@index([organizationId, entityType, entityId, createdAt])
}

model Invitation {
 id             String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 organization   Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 email          String
 name           String
 tokenHash      String @unique
 invitedById    String @db.Uuid
 expiresAt      DateTime
 acceptedAt     DateTime?
 revokedAt      DateTime?
 createdAt      DateTime @default(now())
 @@index([organizationId, createdAt, id])
 @@index([organizationId, email])
}
model BusinessTask {
 comments       TaskComment[]
 notifications  Notification[]
 id             String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 organization   Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 title          String
 description    String @default("")
 status         TaskStatus @default(TODO)
 version        Int @default(1)
 dueDate        DateTime? @db.Date
 assigneeId     String @db.Uuid
 assignee       User @relation(fields:[assigneeId,organizationId],references:[id,organizationId],onDelete:Restrict)
 orderId        String? @db.Uuid
 order          Order? @relation(fields:[orderId,organizationId],references:[id,organizationId],onDelete:Restrict)
 createdById    String @db.Uuid
 createdAt      DateTime @default(now())
 updatedAt      DateTime @updatedAt
 @@index([organizationId, status, createdAt, id])
 @@index([organizationId, assigneeId, status])
 @@unique([id, organizationId])
 @@index([organizationId, orderId])
}

model TaskComment {
 id             String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 taskId         String @db.Uuid
 task           BusinessTask @relation(fields:[taskId,organizationId],references:[id,organizationId],onDelete:Cascade)
 authorId       String @db.Uuid
 author         User @relation(fields:[authorId,organizationId],references:[id,organizationId],onDelete:Restrict)
 authorName     String
 body           String @db.VarChar(2000)
 idempotencyKey String @db.Uuid
 createdAt      DateTime @default(now())
 @@unique([organizationId, authorId, idempotencyKey])
 @@index([organizationId, taskId, createdAt, id])
}

enum NotificationKind {
 TASK_ASSIGNED
 TASK_STATUS_CHANGED
 TASK_COMMENT_ADDED
}
model Notification {
 id             String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 recipientId    String @db.Uuid
 recipient      User @relation(fields:[recipientId,organizationId],references:[id,organizationId],onDelete:Cascade)
 taskId         String @db.Uuid
 task           BusinessTask @relation(fields:[taskId,organizationId],references:[id,organizationId],onDelete:Cascade)
 kind           NotificationKind
 eventKey       String @db.VarChar(160)
 actorName      String
 taskStatus     TaskStatus?
 createdAt      DateTime @default(now())
 readAt         DateTime?
 @@unique([organizationId,recipientId,eventKey])
 @@index([organizationId,recipientId,createdAt,id])
 @@index([organizationId,recipientId,readAt])
}
