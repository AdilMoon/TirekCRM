generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum OrderStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum UserRole {
  OWNER
  EMPLOYEE
}
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}
model Organization {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  currency     String @default("KZT")
  address      String @default("")
  businessId   String @default("")
  auditEvents  AuditEvent[]
  privacyRequests PrivacyRequest[]
  invitations  Invitation[]
  tasks        BusinessTask[]
  orderSeq     Int @default(0)
  documentSeq  Int @default(0)
  bankName String @default("")
  iban String @default("")
  bic String @default("")
  version Int @default(1)
  users        User[]
  clients      Client[]
  orders       Order[]
  payments     Payment[]
  expenses     Expense[]
  documents    Document[]
  workTimeEntries WorkTimeEntry[]
}
model User {
  id             String @id @default(uuid()) @db.Uuid
  email          String @unique
  name           String
  passwordHash   String
  role           UserRole @default(EMPLOYEE)
  isActive       Boolean @default(true)
  version        Int @default(1)
  assignedTasks  BusinessTask[]
  taskComments   TaskComment[]
  notifications  Notification[]
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  sessions       Session[]
  passwordReset  PasswordReset?
  mailMessages MailMessage[]
  workProfile WorkProfile?
  bookings WorkBooking[]
  telegramLink TelegramLink?
  telegramPairing TelegramPairing?
  workTimeEntries WorkTimeEntry[] @relation("WorkTimeEmployee")
  enteredWorkTime WorkTimeEntry[] @relation("WorkTimeCreator")
  @@unique([id, organizationId])
}
enum WorkTimeStatus {
  SUBMITTED
  APPROVED
  REJECTED
  VOIDED
}
model WorkTimeEntry {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id])
  employeeId String @db.Uuid
  employee User @relation("WorkTimeEmployee", fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdById String @db.Uuid
  createdBy User @relation("WorkTimeCreator", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)
  startsAt DateTime
  endsAt DateTime
  status WorkTimeStatus @default(SUBMITTED)
  decisionNote String @default("") @db.VarChar(300)
  version Int @default(1)
  idempotencyKey String @db.Uuid
  createdAt DateTime @default(now())

  @@unique([organizationId, createdById, idempotencyKey])
  @@index([organizationId, startsAt, id])
  @@index([organizationId, employeeId, startsAt, id])
}
model Session {
  id String @unique @default(uuid()) @db.Uuid
  createdAt DateTime? @default(now())
  userAgent String @default("") @db.VarChar(300)
  tokenHash String @id
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
  @@index([userId, expiresAt])
}
model PasswordReset {
  userId String @id @db.Uuid
  user User @relation(fields:[userId],references:[id],onDelete:Cascade,onUpdate:Cascade)
  tokenHash String @unique @db.VarChar(64)
  credentialHash String @db.VarChar(64)
  requestedAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
}
model MailMessage {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  organizationId String @db.Uuid
  user User @relation(fields:[userId,organizationId],references:[id,organizationId],onDelete:Cascade,onUpdate:Cascade)
  recipient String @db.VarChar(254)
  kind String @db.VarChar(32)
  eventKey String @db.VarChar(160)
  deliveryMode String @db.VarChar(16)
  payload String?
  expiresAt DateTime?
  status String @default("PENDING") @db.VarChar(16)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  lastErrorCode String? @db.VarChar(32)
  createdAt DateTime @default(now())
  sentAt DateTime?
  @@unique([organizationId,eventKey])
  @@index([deliveryMode,status,nextAttemptAt,createdAt])
}
model Client {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  phone          String @default("")
  email          String @default("")
  company        String @default("")
  address        String @default("")
  createdAt      DateTime @default(now())
  businessId String @default("")
  bankName String @default("")
  iban String @default("")
  bic String @default("")
  version Int @default(1)
  orders         Order[]
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
}
model Order {
  bookings WorkBooking[]
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  clientId       String @db.Uuid
  client         Client @relation(fields: [clientId, organizationId], references: [id, organizationId])
  number         Int
  title          String
  status         OrderStatus @default(NEW)
  version        Int @default(1)
  total          Decimal @db.Decimal(18,2)
  dueDate        DateTime? @db.Date
  notes          String @default("")
  createdAt      DateTime @default(now())
  items          OrderItem[]
  payments       Payment[]
  expenses       Expense[]
  documents      Document[]
  tasks          BusinessTask[]
  intakeReceipt  MessageOrderReceipt?
  passport       OrderPassport?
  photos         OrderPhoto[]
  @@unique([organizationId, number])
  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt, id])
}
model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @db.Uuid
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(18,2)
  total       Decimal @db.Decimal(18,2)
}
model Payment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderId        String @db.Uuid
  order          Order @relation(fields: [orderId, organizationId], references: [id, organizationId])
  amount         Decimal @db.Decimal(18,2)
  note           String @default("")
  idempotencyKey String @db.Uuid
  createdAt      DateTime @default(now())
  refunds PaymentRefund[]
  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
}
model Expense {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderId        String? @db.Uuid
  order          Order? @relation(fields: [orderId, organizationId], references: [id, organizationId])
  amount         Decimal @db.Decimal(18,2)
  description    String
  category       String
  idempotencyKey String @db.Uuid
  createdAt      DateTime @default(now())
  reversal ExpenseReversal?
  replaces ExpenseReversal? @relation("ExpenseReplacement")
  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
}
model Document {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderId        String @db.Uuid
  order          Order @relation(fields: [orderId, organizationId], references: [id, organizationId])
  number         Int
  kind           String @default("ACT_DRAFT")
  idempotencyKey String? @db.Uuid
  status         String @default("DRAFT")
  version        Int @default(1)
  annulledAt     DateTime?
  annulledById   String? @db.Uuid
  annulledByName String?
  annulmentReason String?
  annulmentKey   String? @db.Uuid
  snapshot       Json
  createdAt      DateTime @default(now())
  @@unique([organizationId, number])
  @@unique([organizationId, annulmentKey])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
}

model AuditEvent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String @db.Uuid
  actorName      String
  entityType     String
  entityId       String @db.Uuid
  action         String
  metadata       Json
  createdAt      DateTime @default(now())
  @@index([organizationId, createdAt, id])
  @@index([organizationId, entityType, entityId, createdAt])
}

model Invitation {
 id             String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 organization   Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 email          String
 name           String
 tokenHash      String @unique
 invitedById    String @db.Uuid
 expiresAt      DateTime
 acceptedAt     DateTime?
 revokedAt      DateTime?
 createdAt      DateTime @default(now())
 @@index([organizationId, createdAt, id])
 @@index([organizationId, email])
}
model BusinessTask {
 booking WorkBooking?
 comments       TaskComment[]
 notifications  Notification[]
 id             String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 organization   Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 title          String
 description    String @default("")
 status         TaskStatus @default(TODO)
 version        Int @default(1)
 dueDate        DateTime? @db.Date
 assigneeId     String @db.Uuid
 assignee       User @relation(fields:[assigneeId,organizationId],references:[id,organizationId],onDelete:Restrict)
 orderId        String? @db.Uuid
 order          Order? @relation(fields:[orderId,organizationId],references:[id,organizationId],onDelete:Restrict)
 createdById    String @db.Uuid
 createdAt      DateTime @default(now())
 updatedAt      DateTime @updatedAt
 @@index([organizationId, status, createdAt, id])
 @@index([organizationId, assigneeId, status])
 @@unique([id, organizationId])
 @@index([organizationId, orderId])
}

model WorkProfile {
 @@unique([userId,organizationId])
 userId String @id @db.Uuid
 organizationId String @db.Uuid
 user User @relation(fields:[userId,organizationId],references:[id,organizationId],onDelete:Cascade)
 skills String[]
 weekdays Int[]
 startMinute Int
 endMinute Int
 version Int @default(1)
}
model WorkBooking {
 @@unique([taskId,organizationId])
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 orderId String @db.Uuid
 order Order @relation(fields:[orderId,organizationId],references:[id,organizationId],onDelete:Cascade)
 employeeId String @db.Uuid
 employee User @relation(fields:[employeeId,organizationId],references:[id,organizationId],onDelete:Restrict)
 taskId String @unique @db.Uuid
 task BusinessTask @relation(fields:[taskId,organizationId],references:[id,organizationId],onDelete:Cascade)
 startsAt DateTime @db.Timestamp(3)
 endsAt DateTime @db.Timestamp(3)
 requiredSkills String[]
 createdById String @db.Uuid
 idempotencyKey String @db.Uuid
 inputHash String @db.VarChar(64)
 createdAt DateTime @default(now())
 releasedAt DateTime?
 @@unique([organizationId,idempotencyKey])
 @@index([organizationId,startsAt,endsAt])
}

model TaskComment {
 id             String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 taskId         String @db.Uuid
 task           BusinessTask @relation(fields:[taskId,organizationId],references:[id,organizationId],onDelete:Cascade)
 authorId       String @db.Uuid
 author         User @relation(fields:[authorId,organizationId],references:[id,organizationId],onDelete:Restrict)
 authorName     String
 body           String @db.VarChar(2000)
 idempotencyKey String @db.Uuid
 createdAt      DateTime @default(now())
 @@unique([organizationId, authorId, idempotencyKey])
 @@index([organizationId, taskId, createdAt, id])
}

enum NotificationKind {
 TASK_ASSIGNED
 TASK_STATUS_CHANGED
 TASK_COMMENT_ADDED
}
model Notification {
 telegramDeliveries TelegramDelivery[]
 id             String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 recipientId    String @db.Uuid
 recipient      User @relation(fields:[recipientId,organizationId],references:[id,organizationId],onDelete:Cascade)
 taskId         String @db.Uuid
 task           BusinessTask @relation(fields:[taskId,organizationId],references:[id,organizationId],onDelete:Cascade)
 kind           NotificationKind
 eventKey       String @db.VarChar(160)
 actorName      String
 taskStatus     TaskStatus?
 createdAt      DateTime @default(now())
 readAt         DateTime?
 @@unique([organizationId,recipientId,eventKey])
 @@unique([id,organizationId])
 @@index([organizationId,recipientId,createdAt,id])
 @@index([organizationId,recipientId,readAt])
}

model TelegramPairing {
 id String @id @default(uuid()) @db.Uuid
 userId String @unique @db.Uuid
 organizationId String @db.Uuid
 user User @relation(fields:[userId,organizationId],references:[id,organizationId],onDelete:Cascade)
 botId String @db.VarChar(20)
 tokenHash String @unique @db.VarChar(64)
 expiresAt DateTime
 telegramUserId String? @db.VarChar(20)
 displayName String @default("") @db.VarChar(160)
 username String @default("") @db.VarChar(32)
 @@unique([userId,organizationId])
}
model TelegramLink {
 id String @id @default(uuid()) @db.Uuid
 userId String @unique @db.Uuid
 organizationId String @db.Uuid
 user User @relation(fields:[userId,organizationId],references:[id,organizationId],onDelete:Cascade)
 botId String @db.VarChar(20)
 telegramUserId String @db.VarChar(20)
 displayName String @db.VarChar(160)
 username String @db.VarChar(32)
 locale String @default("ru") @db.VarChar(2)
 selectedTaskId String? @db.Uuid
 selectedAt DateTime?
 createdAt DateTime @default(now())
 deliveries TelegramDelivery[]
 @@unique([botId,telegramUserId])
 @@unique([id,organizationId])
 @@unique([userId,organizationId])
}
model TelegramDelivery {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 linkId String @db.Uuid
 link TelegramLink @relation(fields:[linkId,organizationId],references:[id,organizationId],onDelete:Cascade)
 notificationId String @db.Uuid
 notification Notification @relation(fields:[notificationId,organizationId],references:[id,organizationId],onDelete:Cascade)
 status String @default("PENDING") @db.VarChar(16)
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 messageId String? @db.VarChar(20)
 createdAt DateTime @default(now())
 sentAt DateTime?
 @@unique([linkId,notificationId])
 @@index([status,nextAttemptAt,createdAt])
}
model TelegramBotState {
 botId String @id @db.VarChar(20)
 nextUpdateId BigInt @default(0)
 lastPollAt DateTime?
 leaseToken String? @db.Uuid
 leaseUntil DateTime?
}
model TelegramUpdateReceipt {
 botId String @db.VarChar(20)
 updateId BigInt
 createdAt DateTime @default(now())
 @@id([botId,updateId])
 @@index([createdAt])
}

model PrivacyRequest {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
 kind String
 status String @default("OPEN")
 subjectName String
 contact String @default("")
 description String
 receivedOn DateTime @db.Date
 dueOn DateTime? @db.Date
 resolution String @default("")
 createdById String @db.Uuid
 createdByName String
 creationKey String @db.Uuid
 changes PrivacyRequestChangeReceipt[]
 version Int @default(1)
 closedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([organizationId,creationKey])
 @@unique([id,organizationId])
 @@index([organizationId,dueOn,createdAt,id])
}

model PrivacyRequestChangeReceipt {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 requestId String @db.Uuid
 request PrivacyRequest @relation(fields:[requestId,organizationId],references:[id,organizationId],onDelete:Cascade)
 idempotencyKey String @db.Uuid
 actorId String @db.Uuid
 inputHash String @db.VarChar(64)
 createdAt DateTime @default(now())
 @@unique([organizationId,idempotencyKey])
}

model PaymentRefund {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 paymentId String @db.Uuid
 payment Payment @relation(fields:[paymentId,organizationId],references:[id,organizationId],onDelete:Cascade)
 amount Decimal @db.Decimal(18,2)
 reason String
 actorId String @db.Uuid
 actorName String
 idempotencyKey String @db.Uuid
 createdAt DateTime @default(now())
 @@unique([organizationId,idempotencyKey])
 @@index([organizationId,createdAt,id])
 @@index([paymentId,organizationId])
}
model ExpenseReversal {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 expenseId String @db.Uuid
 expense Expense @relation(fields:[expenseId,organizationId],references:[id,organizationId],onDelete:Cascade)
 replacementExpenseId String? @db.Uuid
 replacementExpense Expense? @relation("ExpenseReplacement",fields:[replacementExpenseId,organizationId],references:[id,organizationId],onDelete:Restrict,onUpdate:Cascade)
 amount Decimal @db.Decimal(18,2)
 reason String
 actorId String @db.Uuid
 actorName String
 idempotencyKey String @db.Uuid
 createdAt DateTime @default(now())
 @@unique([expenseId,organizationId])
 @@unique([replacementExpenseId,organizationId])
 @@unique([organizationId,idempotencyKey])
 @@index([organizationId,createdAt,id])
}

model MessageOrderReceipt {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @db.Uuid
 idempotencyKey String @db.Uuid
 inputHash String @db.VarChar(64)
 actorId String @db.Uuid
 orderId String @unique @db.Uuid
 order Order @relation(fields:[orderId,organizationId],references:[id,organizationId],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@unique([organizationId,idempotencyKey])
 @@unique([orderId,organizationId])
}
model OrderPassport {
 orderId String @id @db.Uuid
 organizationId String @db.Uuid
 order Order @relation(fields:[orderId,organizationId],references:[id,organizationId],onDelete:Cascade)
 tokenHash String @unique @db.VarChar(64)
 expiresAt DateTime
 revokedAt DateTime?
 revision Int @default(1)
 confirmedAt DateTime?
 confirmedOrderVersion Int?
 confirmedRevision Int?
 @@unique([orderId,organizationId])
}
model OrderPhoto {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 organizationId String @db.Uuid
 createdById String @db.Uuid
 order Order @relation(fields:[orderId,organizationId],references:[id,organizationId],onDelete:Cascade)
 phase String @db.VarChar(6)
 shared Boolean @default(false)
 image Bytes
 inputHash String @db.VarChar(64)
 idempotencyKey String @db.Uuid
 createdAt DateTime @default(now())
 @@unique([orderId,idempotencyKey])
 @@index([orderId,organizationId,createdAt,id])
}
