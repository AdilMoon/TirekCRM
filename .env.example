# Only local development. Copy with npm run setup.
DATABASE_URL=postgresql://tirek:tirek_local_only@127.0.0.1:54329/tirek
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# npm run dev:https overrides WEB_ORIGIN to https://localhost:8443 for its children.
DEMO_SEED=true
DEMO_PASSWORD=TirekDemo2026!

# Optional override. When unset: enabled locally, disabled in production.
# REGISTRATION_ENABLED=false

# Account mail: local files in development; production defaults disabled when unset.
# Set gmail only after configuring your own Google App Password. Never commit .env.
MAIL_DELIVERY=local
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Generated by npm run setup. Retain this key while encrypted mail is pending.
MAIL_ENCRYPTION_KEY=

# Optional recovery override; normally follows MAIL_DELIVERY. Local mode is forbidden in production.
# PASSWORD_RESET_DELIVERY=disabled
