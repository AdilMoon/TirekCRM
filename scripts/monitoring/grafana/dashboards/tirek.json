      "targets": [
        {
          "expr": "up{job=\"tirek-api\"}",
          "refId": "A",
          "legendFormat": "API доступен"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
